# Matrix
MATRIX_HOMESERVER_URL=https://matrix.example.com
MATRIX_ACCESS_TOKEN=syt_your_token_here
MATRIX_BOT_USER_ID=@bot:example.com
MATRIX_OWNER_USER_ID=@you:example.com

# Claude
CLAUDE_MODEL=sonnet
CLAUDE_DEFAULT_WORKDIR=/home/user/projects

# Ports
RELAY_PORT_START=9000
RELAY_PORT_END=9015

# Bot
DATABASE_PATH=./data/bot.db
SUPERVISOR_API_PORT=9090
LOG_LEVEL=info

# Replay
REPLAY_MAX_PAIRS=20

# Required hardened-deployment secrets (generated by mise run setup)
MATRIX_ENABLE_E2EE=true
CMB_RELAY_SECRET=
# Only directories under this real path can be used with /new or /attach
CMB_ALLOWED_WORKDIR_ROOT=/home/user/projects
